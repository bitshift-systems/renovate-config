{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",

    "./annotated.json5",
    "./autoMerge.json5",
    "./groups.json5",
    "./labels.json5",
    "./semanticCommits.json5",
    "./sharedActions.json5",

    ":automergePr",
    ":configMigration",
    ":dependencyDashboard",
    ":disableRateLimiting"
  ],

  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prHourlyLimit": 1,

  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**"
  ],

  "registryAliases": {
    "mirror.gcr.io": "docker.io"
  },

  "packageRules": [
    {
      "description": "NPM Bump Range Strategy",
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Hold package-registry updates (Go modules, npm, crates) until they are 3 days old, the same window as the github-actions and mise groups",
      "matchCategories": ["golang", "js", "rust"],
      "minimumReleaseAge": "3 days"
    }
  ]
}
